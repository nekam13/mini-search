<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Mini Search</string>
    <key>CFBundleDisplayName</key>
    <string>Mini Search</string>
    <key>CFBundleIdentifier</key>
    <string>cz.minisearch.desktop</string>
    <key>CFBundleVersion</key>
    <string>7.9</string>
    <key>CFBundleShortVersionString</key>
    <string>7.9</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleExecutable</key>
    <string>mini-search</string>
    <key>LSMinimumSystemVersion</key>
    <string>11.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- The app crawls arbitrary sites over HTTP/HTTPS, including plain-HTTP
         local dev servers, so App Transport Security must allow non-TLS. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Mini Search indexuje weby ve vaší lokální síti, když to výslovně zadáte.</string>
</dict>
</plist>
