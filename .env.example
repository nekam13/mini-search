# Mini Search – příklad konfigurace pro Termux/Android.
# Zkopírujte na .env a upravte; start.sh ho automaticky načte.

# Úsporný režim: vypne embeddingy a sníží počet vláken.
MINISEARCH_PROFILE=lowmem

# Počet crawlovacích vláken (1 je na telefonu ideální).
MINISEARCH_WORKERS=1

# Vektorové vyhledávání:
#   auto = zapnout, pokud je dost RAM a baterie (výchozí v lowmem režimu)
#   1/0  = natvrdo zapnout / vypnout (pouze FTS5, nejméně RAM)
MINISEARCH_EMBEDDINGS=auto
# Prahy pro 'auto': pod tímto volným RAM (MB) se vektory vypnou.
MINISEARCH_MIN_FREE_MB=300
# Pod tímto % baterie a bez nabíjení se vektory vypnou.
MINISEARCH_MIN_BATTERY_PCT=15

# HTTP a retry.
MINISEARCH_REQUEST_TIMEOUT=30
MINISEARCH_MAX_RETRIES=3
MINISEARCH_RETRY_MAX_DELAY=5

# Maximální délka těla stránky (šetří místo v DB).
MINISEARCH_MAX_BODY_CHARS=3500

# Wikipedie.
MINISEARCH_WIKI_LANG=cs
MINISEARCH_WIKI_BATCH=50
# MINISEARCH_WIKI_API_BASE=https://cs.wikipedia.org

# Cesta k databázi (výchozí console.db v aktuálním adresáři).
# MINISEARCH_DB=/data/data/com.termux/files/home/mini-search/console.db
