# Mini Search – příklad konfigurace pro Termux/Android.
# Zkopírujte na .env a upravte; start.sh ho automaticky načte.

# Úsporný režim: vypne embeddingy a sníží počet vláken.
MINISEARCH_PROFILE=lowmem

# Počet crawlovacích vláken (1 je na telefonu ideální).
MINISEARCH_WORKERS=1

# Vektorové vyhledávání:
#   auto = zapnout, pokud je dost RAM a baterie (výchozí v lowmem režimu)
#   1/0  = natvrdo zapnout / vypnout (pouze FTS5, nejméně RAM)
MINISEARCH_EMBEDDINGS=auto
# Prahy pro 'auto': pod tímto volným RAM (MB) se vektory vypnou.
MINISEARCH_MIN_FREE_MB=300
# Pod tímto % baterie a bez nabíjení se vektory vypnou.
MINISEARCH_MIN_BATTERY_PCT=15

# HTTP a retry.
MINISEARCH_REQUEST_TIMEOUT=10
MINISEARCH_MAX_RETRIES=3
MINISEARCH_RETRY_MAX_DELAY=5

# Maximální délka těla stránky (šetří místo v DB).
MINISEARCH_MAX_BODY_CHARS=3500

# Kolik odkazů smí jedna stránka přidat do fronty (0 = nevypisovat odkazy).
MINISEARCH_MAX_LINKS_PER_PAGE=100

# SQLite: velikost cache v KiB a kam ukládat dočasné tabulky (0=default,
# 1=soubor, 2=RAM). Nízké hodnoty šetří RAM na mobilu.
MINISEARCH_SQLITE_CACHE_KB=2048
MINISEARCH_SQLITE_TEMP_STORE=1

# Strop pro hnswlib index; nad ním se vektory neindexují a hledá se jen FTS5.
MINISEARCH_HNSW_MAX_ELEMENTS=20000

# Wikipedie.
MINISEARCH_WIKI_LANG=cs
MINISEARCH_WIKI_BATCH=50
# MINISEARCH_WIKI_API_BASE=https://cs.wikipedia.org

# Cesta k databázi (výchozí console.db v aktuálním adresáři).
# MINISEARCH_DB=/data/data/com.termux/files/home/mini-search/console.db

# Noční údržba ("dreaming mode") – python3 app_combined.py --maintenance
# Průběh se loguje sem (mimo repo se hodí absolutní cesta):
# MINISEARCH_MAINTENANCE_LOG=logs/maintenance.log
# Kolik článků Wikipedie na jednu noc (0 = přeskočit import):
MINISEARCH_MAINT_WIKI_PAGES=200
# Kolik stránek na běh dopočítat vektory (jen když jsou vektory povolené):
MINISEARCH_MAINT_EMBED_BATCH=200
# Kontrola mrtvých odkazů: kolik nejstarších stránek ověřit (0 = vypnuto).
MINISEARCH_MAINT_LINK_CHECK=0
# Smazat stránky, které vrátí 404/410? (0/1)
MINISEARCH_MAINT_PURGE_DEAD=0
# Minimální volné místo (MB) potřebné pro VACUUM.
MINISEARCH_MAINT_VACUUM_MIN_MB=50
# Spouštět údržbu automaticky na pozadí (0/1) a v kolik hodin.
MINISEARCH_NIGHTLY=0
MINISEARCH_NIGHTLY_HOUR=3
