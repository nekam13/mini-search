<?xml version="1.0" encoding="utf-8"?>
<!-- Clay card: soft rounded white surface with a hairline border, mirroring
     .card in clay.css (radius 12dp, #fff on #F5F5F5, 1dp #E0E0E0 border). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/clay_card" />
    <corners android:radius="14dp" />
    <stroke android:width="1dp" android:color="@color/clay_border" />
</shape>
