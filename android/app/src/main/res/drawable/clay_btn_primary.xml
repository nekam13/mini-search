<?xml version="1.0" encoding="utf-8"?>
<!-- Clay primary button, mirroring .btn-primary in clay.css (green gradient,
     pill corners, white text). Used as the background of native buttons. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/clay_primary_dark" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/clay_primary" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
