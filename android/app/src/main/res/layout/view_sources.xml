<?xml version="1.0" encoding="utf-8"?>
<!-- Native "Zdroje" screen: adding and managing sources lives in the app, not
     in the WebView admin panel. The list is rendered from the JSON the Python
     bridge returns (get_all_sources), so there is exactly one source of truth. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/clay_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/clay_card"
                android:padding="18dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sources_title"
                    android:textColor="@color/clay_text"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:paddingBottom="10dp"
                    android:text="@string/sources_note"
                    android:textColor="@color/clay_text_light"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/source_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/sources_url_hint"
                    android:inputType="textUri"
                    android:autofillHints="url"
                    android:maxLines="1"
                    android:textColor="@color/clay_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="10dp"
                    android:text="@string/sources_type_label"
                    android:textColor="@color/clay_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/source_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/source_add"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/clay_btn_primary"
                    android:textColor="#FFFFFF"
                    android:textAllCaps="false"
                    android:text="@string/sources_add" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/source_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/source_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:background="@drawable/clay_status_ok"
                android:textColor="@color/clay_ok_text"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
