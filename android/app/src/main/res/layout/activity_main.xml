<?xml version="1.0" encoding="utf-8"?>
<!-- The whole app shell is native: five Clay tabs, each a real Android view.
     There is no WebView anywhere — search, sources, sites and settings are all
     native screens backed by the bundled Python server. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/clay_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/clay_card"
        android:padding="6dp"
        android:gravity="center_vertical">

        <!-- The tab strip scrolls horizontally so five tabs plus the pinned
             "Import dumpu" action never overflow a narrow phone screen. -->
        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/tab_home"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAllCaps="false"
                    android:background="@drawable/clay_tab"
                    android:textColor="@color/clay_tab_text"
                    android:text="@string/tab_home" />

                <Button
                    android:id="@+id/tab_search"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAllCaps="false"
                    android:background="@drawable/clay_tab"
                    android:textColor="@color/clay_tab_text"
                    android:text="@string/tab_search" />

                <Button
                    android:id="@+id/tab_sources"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAllCaps="false"
                    android:background="@drawable/clay_tab"
                    android:textColor="@color/clay_tab_text"
                    android:text="@string/tab_sources" />

                <Button
                    android:id="@+id/tab_web"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAllCaps="false"
                    android:background="@drawable/clay_tab"
                    android:textColor="@color/clay_tab_text"
                    android:text="@string/tab_web" />

                <Button
                    android:id="@+id/tab_settings"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAllCaps="false"
                    android:background="@drawable/clay_tab"
                    android:textColor="@color/clay_tab_text"
                    android:text="@string/tab_settings" />

            </LinearLayout>
        </HorizontalScrollView>

        <Button
            android:id="@+id/import_dump"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAllCaps="false"
            android:text="@string/action_import_dump" />
    </LinearLayout>

    <!-- Slim status strip, always visible regardless of the active tab. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/clay_card"
        android:paddingHorizontal="12dp"
        android:paddingBottom="6dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="@color/clay_text_light"
            android:text="@string/state_starting" />

        <Button
            android:id="@+id/retry"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:textAllCaps="false"
            android:textColor="@color/clay_secondary_dark"
            android:text="@string/action_retry" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/home_view"
            layout="@layout/view_home" />

        <include
            android:id="@+id/search_view"
            layout="@layout/view_search"
            android:visibility="gone" />

        <include
            android:id="@+id/sources_view"
            layout="@layout/view_sources"
            android:visibility="gone" />

        <include
            android:id="@+id/sites_view"
            layout="@layout/view_sites"
            android:visibility="gone" />

        <include
            android:id="@+id/settings_view"
            layout="@layout/view_settings"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
