<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/clay_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/clay_card"
        android:padding="6dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/tab_home"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAllCaps="false"
            android:background="@drawable/clay_tab"
            android:textColor="@color/clay_tab_text"
            android:text="@string/tab_home" />

        <Button
            android:id="@+id/tab_search"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAllCaps="false"
            android:background="@drawable/clay_tab"
            android:textColor="@color/clay_tab_text"
            android:text="@string/tab_search" />

        <Button
            android:id="@+id/tab_admin"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAllCaps="false"
            android:background="@drawable/clay_tab"
            android:textColor="@color/clay_tab_text"
            android:text="@string/tab_admin" />

        <Button
            android:id="@+id/tab_settings"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAllCaps="false"
            android:background="@drawable/clay_tab"
            android:textColor="@color/clay_tab_text"
            android:text="@string/tab_settings" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/import_dump"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAllCaps="false"
            android:text="@string/action_import_dump" />
    </LinearLayout>

    <!-- Slim status strip, always visible regardless of the active tab. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/clay_card"
        android:paddingHorizontal="12dp"
        android:paddingBottom="6dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="@color/clay_text_light"
            android:text="@string/state_starting" />

        <Button
            android:id="@+id/retry"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:textAllCaps="false"
            android:textColor="@color/clay_secondary_dark"
            android:text="@string/action_retry" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/home_view"
            layout="@layout/view_home" />

        <include
            android:id="@+id/settings_view"
            layout="@layout/view_settings"
            android:visibility="gone" />

        <!-- The WebView is created programmatically and only when the user
             first opens the search or admin tab. Inflating it here would make
             Activity.onCreate heavy enough to blow the foreground-service
             start deadline on a slow device (the service would be killed with
             ForegroundServiceDidNotStartInTimeException). -->
        <FrameLayout
            android:id="@+id/web_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
